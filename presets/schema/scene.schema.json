{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAW Visualizer scene preset (schemaVersion 0.6.x)",
  "description": "Mô tả lược đồ cho tài liệu và test. Việc kiểm lúc chạy là sanitizeScene (packages/render-core/src/scene.ts): trường lạ bị bỏ, giá trị sai về mặc định kèm WARN_PRESET_*.",
  "type": "object",
  "required": ["schemaVersion", "canvas", "widgets"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^0\\.[3456]\\.\\d+$" },
    "presetName": { "type": "string", "maxLength": 200 },
    "author": { "type": "string", "maxLength": 200 },
    "canvas": {
      "type": "object",
      "properties": {
        "aspectRatio": { "type": "string" },
        "designWidth": { "type": "integer", "minimum": 256, "maximum": 4096 },
        "designHeight": { "type": "integer", "minimum": 256, "maximum": 4096 },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundImageData": { "type": "null" },
        "snapping": {
          "type": "object",
          "properties": {
            "gridEnabled": { "type": "boolean" },
            "gridSize": { "type": "number", "minimum": 1, "maximum": 256 },
            "smartGuidesEnabled": { "type": "boolean" }
          }
        }
      }
    },
    "textStyles": {
      "type": "object",
      "description": "Bộ kiểu chữ dựng sẵn của preset (thêm ở 0.5.0). Vắng = bộ mặc định (title, subtitle, heading, body, caption, label, counter, clock, tiny); kiểu trùng id ghi đè kiểu mặc định. Tối đa 64.",
      "propertyNames": { "pattern": "^[A-Za-z][\\w-]{0,31}$" },
      "maxProperties": 64,
      "additionalProperties": { "$ref": "#/$defs/textStyle" }
    },
    "noteNaming": { "type": "object", "description": "Cách ghi tên nốt và hợp âm cho mọi widget (P-12). Vắng = cách ghi cũ.", "additionalProperties": false,
      "properties": { "system": { "enum": ["LETTER", "SOLFEGE", "GERMAN"] }, "accidental": { "enum": ["SHARP", "FLAT"] }, "ascii": { "type": "boolean" }, "middleC": { "enum": [3, 4] } } },
    "tonic": { "type": "integer", "minimum": 0, "maximum": 11, "description": "Nốt chủ của bài (0 = C … 11 = B); dùng cho chỗ giữ {bass} (T-83). Trường tuỳ chọn." },
    "phases": {
      "type": "array",
      "maxItems": 64,
      "description": "Các phase của bài (verse, chorus…), sắp theo start (giây); phase kéo dài tới phase kế. Dùng cho chỗ giữ {phase}, {next_phase}, {phase_elapsed}, {phase_remaining}, {phase_no} (T-81). Thêm không đổi số phiên bản: trường tuỳ chọn.",
      "items": {
        "type": "object",
        "required": ["name", "start"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "start": { "type": "number", "minimum": 0, "maximum": 86400 } }
      }
    },
    "widgets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "type": { "enum": ["TRACK_INFO", "PIANO_ROLL", "EVENT_COUNTER", "LIVE_TRIGGER", "TIME_BAR", "CHORD_DETECTION", "AUDIO_SPECTRUM", "PROGRESS_BAR", "TEXT", "PARTICLES", "NOTATION", "TEMPO_INFO", "BAR_BEAT", "KEY_SCALE", "VELOCITY", "DENSITY", "PITCH_WHEEL", "ARRANGEMENT", "DRUM_PAD", "SECTION", "LYRICS", "AUTOMATION"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Tên lớp do người dùng đặt; không trùng nhau. Vắng thì dùng tên theo loại." },
          "zIndex": { "type": "integer", "minimum": -10000, "maximum": 10000 },
          "visible": { "type": "boolean" },
          "animate": { "type": "object", "description": "Hoạt hình thuộc tính (T-22): khoá là đường dẫn thuộc tính (layout.x…, opacity, hoặc thuộc tính số/màu của widget); giá trị là { keys: [...] } hoặc { bind, from, to }.",
            "maxProperties": 24, "additionalProperties": { "type": "object", "properties": {
              "keys": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["at", "value"], "properties": { "at": { "type": "object" }, "value": { "type": ["number", "string"] }, "ease": {}, "interp": { "enum": ["linear", "hold", "smooth"] } } } },
              "loop": { "enum": ["NONE", "CYCLE", "PINGPONG", "OFFSET"] },
              "bind": { "enum": ["beat.phase", "bar.phase", "progress", "notes.count", "notes.velocity", "note.hit", "track.volume", "track.pan", "audio.level"] },
              "from": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "to": { "type": "array", "minItems": 2, "maxItems": 2 }, "ease": {} } } },
          "motion": { "type": "object", "description": "Chuyển động cấp widget (vào, ra, lặp theo nhịp) cho mọi loại widget. Vắng = không chuyển động.", "additionalProperties": false,
            "properties": {
              "enter": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/motionPhase" }] },
              "exit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/motionPhase" }] },
              "loop": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "properties": {
                "effect": { "enum": ["breathe", "float", "sway", "pulse", "blink", "wobble"] }, "amount": { "type": "number", "minimum": 0, "maximum": 1 },
                "every": { "type": "number", "minimum": 0.05, "maximum": 64 }, "unit": { "enum": ["BEATS", "SECONDS"] } } }] } } },
          "visibility": {
            "type": "object",
            "description": "Khoảng hiển thị theo thời gian (REQ-GRAPHICS-14, T-81). Vắng = hiện suốt bài; ranges rỗng = không bao giờ hiện. Hiện dần/ẩn dần làm mượt, co lại nếu khoảng ngắn hơn tổng hai thời gian.",
            "properties": {
              "ranges": { "type": "array", "maxItems": 32, "items": { "type": "object", "required": ["from"],
                "properties": { "from": { "type": "number", "minimum": 0, "maximum": 86400 }, "to": { "type": ["number", "null"], "minimum": 0, "maximum": 86400, "description": "Lớn hơn from; null hoặc vắng = tới hết bài." } } } },
              "fadeIn": { "type": "number", "minimum": 0, "maximum": 30 },
              "fadeOut": { "type": "number", "minimum": 0, "maximum": 30 }
            }
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
              "anchor": {
                "type": "object",
                "description": "Điểm neo xoay theo tỉ lệ khung widget. Vắng (0.3.x) thì dùng tâm. Thêm ở 0.4.0 (REQ-GRAPHICS-03).",
                "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
              }
            }
          },
          "trackMappingMode": { "enum": ["ALL", "MANUAL", "AUTO_ASSIGN_FIRST_MELODIC"] },
          "assignedTrackIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "maxItems": 1024 },
          "properties": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "motionPhase": { "type": "object", "additionalProperties": false, "properties": { "effect": { "enum": ["fade", "slide-from-left", "slide-from-right", "slide-from-top", "slide-from-bottom", "pop", "zoom", "drop", "spin"] }, "sec": { "type": "number", "minimum": 0, "maximum": 30 }, "ease": {} } },
    "textStyle": {
      "type": "object",
      "description": "Thuộc tính chữ (REQ-GRAPHICS-18, T-72). Trong textStyles: kiểu đầy đủ (trường vắng lấy từ kiểu dựng sẵn cùng id hoặc kiểu gốc). Trong widget: ghi đè, chỉ trường có mặt thay kiểu.",
      "properties": {
        "styleId": { "type": "string", "pattern": "^[A-Za-z][\\w-]{0,31}$", "description": "Chỉ dùng trong widget: id kiểu trong textStyles." },
        "name": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Chỉ dùng trong textStyles: tên hiển thị." },
        "font": { "type": "string", "pattern": "^[\\w][\\w \\-]{0,39}$" },
        "weight": { "type": "number", "minimum": 100, "maximum": 900 },
        "italic": { "type": "boolean" },
        "size": { "type": "number", "minimum": 4, "maximum": 400 },
        "scaleX": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "scaleY": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "baselineShift": { "type": "number", "minimum": -400, "maximum": 400 },
        "script": { "enum": ["none", "super", "sub"] },
        "underline": { "type": "boolean" },
        "strike": { "type": "boolean" },
        "decoThickness": { "type": "number", "minimum": 0, "maximum": 50 },
        "decoColor": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6})?$" },
        "textCase": { "enum": ["none", "upper", "lower", "title", "smallCaps"] },
        "tracking": { "type": "number", "minimum": -500, "maximum": 2000, "description": "phần nghìn em" },
        "leading": { "type": "number", "minimum": 0.5, "maximum": 5 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "gradient": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["stops"],
              "properties": {
                "kind": { "enum": ["linear", "radial"] },
                "angle": { "type": "number", "minimum": -360, "maximum": 360 },
                "stops": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": ["at", "color"],
                    "properties": { "at": { "type": "number", "minimum": 0, "maximum": 1 }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
                  }
                }
              }
            }
          ]
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "stroke": {
          "type": "object",
          "properties": {
            "width": { "type": "number", "minimum": 0, "maximum": 50 },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "position": { "enum": ["center", "outside"] },
            "join": { "enum": ["miter", "round", "bevel"] },
            "over": { "type": "boolean" }
          }
        },
        "shadow": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "distance": { "type": "number", "minimum": 0, "maximum": 200 },
            "angle": { "type": "number", "minimum": -360, "maximum": 360 },
            "blur": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "background": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "padX": { "type": "number", "minimum": 0, "maximum": 200 },
            "padY": { "type": "number", "minimum": 0, "maximum": 200 },
            "radius": { "type": "number", "minimum": 0, "maximum": 200 }
          }
        },
        "tabularNums": { "type": "boolean" },
        "overflow": { "enum": ["ellipsis", "shrink", "visible"] },
        "minSize": { "type": "number", "minimum": 4, "maximum": 400 },
        "wrap": { "type": "boolean" },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    }
  }
}
