{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "resolveJsonModule": true, "isolatedModules": true,
    "allowJs": true, "checkJs": false, "types": ["vite/client"]
  },
  "include": ["src", "test"],
  "exclude": ["src/**/*.test.ts"]
}
