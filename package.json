{
  "name": "dawviz",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test:parser && npm run test:render && npm run test:expr && npm run test:web && npm run test:docs-site && npm run test:tools",
    "test:parser": "node --test test/*.test.js",
    "test:render": "node --test packages/render-core/test/*.test.ts",
    "test:expr": "node --test packages/expr/test/*.test.ts",
    "test:web": "node --test apps/web/src/lib/*.test.ts",
    "test:components": "npm run test:components -w @dawviz/web",
    "dev": "npm run dev -w @dawviz/web",
    "build": "npm run build -w @dawviz/web",
    "preview": "npm run preview -w @dawviz/web",
    "typecheck": "npm run typecheck -w @dawviz/web",
    "bundle": "node scripts/bundle.mjs",
    "cli": "node bin/dawparse.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "docs:split": "python3 scripts/split_doc.py",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "docs:sync": "node scripts/sync-docs.mjs",
    "test:docs-site": "node --test scripts/docs-site/markdown.test.mjs",
    "test:tools": "node --test scripts/preset-check/*.test.mjs scripts/community/*.test.mjs",
    "preset:check": "node scripts/preset-check/cli.mjs",
    "a11y": "node scripts/a11y/run.mjs",
    "e2e:m4": "node scripts/e2e/m4-browsers.mjs",
    "docs:site": "node scripts/docs-site/build.mjs",
    "docs:serve": "node scripts/docs-site/build.mjs --serve",
    "notation:e2e": "node scripts/notation/e2e.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "axe-core": "^4.14.1",
    "fontkit": "^3.0.0",
    "playwright-core": "^1.65.1"
  }
}
